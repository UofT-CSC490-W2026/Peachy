# Environment Configuration Template
# Copy this file to .env and fill in your values

# App environment
APP_ENV=development

# AWS API
API_URL=https://dev-api.peachy.app

# AWS Cognito — get these from the AuthStack CloudFormation outputs after deploying Peachy-Infra
# Example: npx cdk deploy --context env=dev  (in Peachy-Infra)
COGNITO_USER_POOL_ID=ca-central-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_DOMAIN=peachy-dev-490.auth.ca-central-1.amazoncognito.com

# Expo Application Services (optional)
# EAS_PROJECT_ID=
